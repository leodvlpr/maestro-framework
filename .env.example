# Copy to .env (git-ignored) and fill in the values for your target:
#   cp .env.example .env
# scripts/run_tests.sh loads this file. Variables prefixed MAESTRO_ are
# available inside flows as ${MAESTRO_...}; the others configure the runner.
# Never commit .env. Secrets for CI come from the CI secret store.

# --- Flow variables ----------------------------------------------------------
# App under test (verified IDs in docs/sut-contract.md)
#   iOS:     org.wikimedia.wikipedia
#   Android: org.wikipedia (not verified yet)
MAESTRO_APP_ID=org.wikimedia.wikipedia
# ios | android — for documented platform-specific behaviour only
MAESTRO_PLATFORM=ios
# sample | staging
MAESTRO_RUN_ENV=sample

# Secrets (not needed for the sample SUT; examples for a real app):
# MAESTRO_TEST_USERNAME=
# MAESTRO_TEST_PASSWORD=

# --- Runner variables (not passed to flows) ----------------------------------
# Device to run on (`maestro --device`). Empty: Maestro picks the connected one.
#   iOS:     xcrun simctl list devices booted
#   Android: adb devices
DEVICE_ID=
# Report format: JUNIT | HTML | HTML-DETAILED | NOOP
REPORT_FORMAT=JUNIT
