# Documentation template only — this project has no .env loader.
# Pass non-secret values with `maestro test -e NAME=value`.
# Export secrets in your shell or CI secret store; Maestro exposes
# MAESTRO_-prefixed shell variables to flows. Never commit a real .env.

# Non-secret runtime values (pass with -e):
# APP_ID=<verified id from docs/sut-contract.md>
# TARGET_PLATFORM=ios
# RUN_ENV=sample
# RUN_ID=local-001

# Secrets (not needed for the sample SUT):
# MAESTRO_TEST_USERNAME=
# MAESTRO_TEST_PASSWORD=
# MAESTRO_CLOUD_API_KEY=
